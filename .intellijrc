# ii - launch IntelliJ IDEA with current directory as project
function ii {
  local pwd
  local dir
  local unameOsName
  local intellijHome
  pwd=$(pwd)
  dir=$(basename "$pwd")
  unameOsName=$(uname)

  ii-sync-maven-settings

  if [[ "$unameOsName" == "Linux" ]]; then

     if [ -n "$INTELLIJ_HOME" ]; then
       intellijHome="$INTELLIJ_HOME"
     fi
     if [ -n "$INTELLIJ_IDEA_HOME" ]; then
       intellijHome="$INTELLIJ_IDEA_HOME"
     fi
     if [ -n "$IDEA_HOME" ]; then
       intellijHome="$IDEA_HOME"
     fi

     if [ -z "$intellijHome" ]; then
       echo "The variable INTELLIJ_HOME or INTELLIJ_IDEA_HOME or IDEA_HOME is not defined"
       return 1
     fi

     "$intellijHome/bin/idea.sh" "../$dir" 1>/dev/null 2>&1 &

  elif [[ "$unameOsName" == "Darwin" ]]; then

    local ideaBin
    if [[ -d "/Applications/IntelliJ IDEA.app" ]]; then
      ideaBin="/Applications/IntelliJ IDEA.app/Contents/MacOS/idea"
    elif [[ -d "$HOME/Applications/IntelliJ IDEA.app" ]]; then
      ideaBin="$HOME/Applications/IntelliJ IDEA.app/Contents/MacOS/idea"
    else
      echo "IntelliJ IDEA.app not found in /Applications or ~/Applications"
      return 1
    fi
    "$ideaBin" "../$dir" 1>/dev/null 2>&1 &

  elif [[ "$unameOsName" == "CYGWIN"* || "$unameOsName" == "MINGW"* || "$unameOsName" == "MSYS"* ]]; then
    echo "Unsupported OS: $unameOsName"
  else
    echo "Unsupported OS: $unameOsName"
    return 1
  fi

}

# ii-sync-maven-settings - set maven user settings file in ./.idea/workspace.xml to settings.xml found by mvn-find-settings, so IntelliJ resolves dependencies like the mvn_ aliases
function ii-sync-maven-settings() {
  local settings
  local workspaceXml
  local tmp
  command -v mvn-find-settings 1>/dev/null 2>&1 || return 0
  settings=$(mvn-find-settings) || return 0
  workspaceXml="$PWD/.idea/workspace.xml"
  tmp="$workspaceXml.tmp"

  if [[ ! -f "$workspaceXml" ]]; then
    mkdir -p "$PWD/.idea"
    cat >"$workspaceXml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<project version="4">
  <component name="MavenImportPreferences">
    <option name="generalSettings">
      <MavenGeneralSettings>
        <option name="userSettingsFile" value="$settings" />
      </MavenGeneralSettings>
    </option>
  </component>
</project>
EOF
  elif grep -q 'name="userSettingsFile"' "$workspaceXml"; then
    SETTINGS="$settings" awk '
      /<option name="userSettingsFile"/ {
        match($0, /^[ \t]*/)
        printf "%s<option name=\"userSettingsFile\" value=\"%s\" />\n", substr($0, 1, RLENGTH), ENVIRON["SETTINGS"]
        next
      }
      { print }
    ' "$workspaceXml" >"$tmp" && mv "$tmp" "$workspaceXml"
  elif ! grep -q 'name="MavenImportPreferences"' "$workspaceXml"; then
    SETTINGS="$settings" awk '
      /<\/project>/ {
        print "  <component name=\"MavenImportPreferences\">"
        print "    <option name=\"generalSettings\">"
        print "      <MavenGeneralSettings>"
        printf "        <option name=\"userSettingsFile\" value=\"%s\" />\n", ENVIRON["SETTINGS"]
        print "      </MavenGeneralSettings>"
        print "    </option>"
        print "  </component>"
      }
      { print }
    ' "$workspaceXml" >"$tmp" && mv "$tmp" "$workspaceXml"
  elif grep -q '<MavenGeneralSettings' "$workspaceXml"; then
    SETTINGS="$settings" awk '
      /<MavenGeneralSettings *\/>/ {
        match($0, /^[ \t]*/)
        indent = substr($0, 1, RLENGTH)
        print indent "<MavenGeneralSettings>"
        printf "%s  <option name=\"userSettingsFile\" value=\"%s\" />\n", indent, ENVIRON["SETTINGS"]
        print indent "</MavenGeneralSettings>"
        next
      }
      /<MavenGeneralSettings>/ {
        print
        match($0, /^[ \t]*/)
        indent = substr($0, 1, RLENGTH)
        printf "%s  <option name=\"userSettingsFile\" value=\"%s\" />\n", indent, ENVIRON["SETTINGS"]
        next
      }
      { print }
    ' "$workspaceXml" >"$tmp" && mv "$tmp" "$workspaceXml"
  else
    SETTINGS="$settings" awk '
      /<component name="MavenImportPreferences"/ {
        match($0, /^[ \t]*/)
        indent = substr($0, 1, RLENGTH)
        selfClosed = ($0 ~ /\/>[ \t]*$/)
        if (selfClosed) {
          print indent "<component name=\"MavenImportPreferences\">"
        } else {
          print
        }
        print indent "  <option name=\"generalSettings\">"
        print indent "    <MavenGeneralSettings>"
        printf "%s      <option name=\"userSettingsFile\" value=\"%s\" />\n", indent, ENVIRON["SETTINGS"]
        print indent "    </MavenGeneralSettings>"
        print indent "  </option>"
        if (selfClosed) {
          print indent "</component>"
        }
        next
      }
      { print }
    ' "$workspaceXml" >"$tmp" && mv "$tmp" "$workspaceXml"
  fi
  echo "IntelliJ maven user settings file: $settings"
}
